# emailish server configuration. Copy to /etc/emailish/emailish.env (systemd) or .env (docker compose).
# Read research/SMTP_ENABLEMENT_REPORT.md first.

# --- sender identity (REQUIRED for SMTP diagnostics) ---------------------------------
# A hostname you own whose A record points to this server AND whose reverse DNS (PTR,
# set in your hosting provider's panel) is this same name.
EMAILISH_HELO_HOST=verify.yourdomain.com
# Envelope sender used in MAIL FROM. Use a real, working mailbox on a domain you own.
EMAILISH_MAIL_FROM=verify-bounces@yourdomain.com

# --- safety ---------------------------------------------------------------------------
EMAILISH_SMTP_ENABLED=true
# During controlled testing, list ONLY domains you own. Every other domain is reported
# UNKNOWN / smtp_not_permitted and is never contacted. Remove (empty) for production use.
EMAILISH_SMTP_ALLOWED_DOMAINS=yourdomain.com,your-catchall-test-domain.com

# --- conservative limits (defaults shown; do not raise them to "speed up") ------------
EMAILISH_SMTP_GLOBAL_CONCURRENCY=8
EMAILISH_SMTP_PER_HOST=1
EMAILISH_SMTP_MX_MIN_INTERVAL=2.0
EMAILISH_SMTP_RCPT_PER_SESSION=10
EMAILISH_SMTP_CONNECT_TIMEOUT=10
EMAILISH_SMTP_COMMAND_TIMEOUT=15
EMAILISH_GREYLIST_RETRY_DELAY=90

EMAILISH_DNS_MODE=auto
EMAILISH_DATA_DIR=/var/lib/emailish

# --- optional commercial provider for addresses emailish cannot settle itself ---------
# MILLIONVERIFIER_API_KEY=
# ZEROBOUNCE_API_KEY=
# HUNTER_API_KEY=
# EMAILISH_PROVIDER=millionverifier
# EMAILISH_PROVIDER_MAX_CHECKS=5000
