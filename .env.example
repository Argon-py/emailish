# emailish settings file. Copy this file to ".env" (same folder) and fill in what you need.
# .env is ignored by git, so your keys are never committed. Restart emailish after editing.
#
# Mailbox checks for addresses emailish cannot confirm itself (e.g. because your internet
# provider blocks port 25). Put ONE provider key here. Only addresses that emailish could not
# settle for free (UNKNOWN / TIMEOUT / undetermined catch-all) are sent, once each.
#
# MILLIONVERIFIER_API_KEY=your-key-here      # https://app.millionverifier.com/api
# ZEROBOUNCE_API_KEY=your-key-here           # https://www.zerobounce.net/members/API
# HUNTER_API_KEY=your-key-here               # https://hunter.io/api-keys
#
# If you set more than one key, choose which one to use:
# EMAILISH_PROVIDER=millionverifier
#
# Safety cap: at most this many paid checks per uploaded file (default 5000).
# EMAILISH_PROVIDER_MAX_CHECKS=5000
#
# Also send catch-all results to the provider (some providers resolve part of them; costs credits):
# EMAILISH_PROVIDER_INCLUDE_CATCH_ALL=false
#
# Turn emailish's own SMTP probing off (recommended on home/office internet, where port 25 is blocked):
# EMAILISH_SMTP_ENABLED=false
